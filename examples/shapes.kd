// Structs, enums with payloads, match.
enum Shape { Circle(f64), Rect(f64, f64), Empty }
struct Point { x: i64, y: i64 }

fn area2(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => 3.0 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Empty => 0.0,
    }
}

fn main() {
    print(area2(Shape::Circle(2.0)));
    print(area2(Shape::Rect(3.0, 4.5)));
    print(area2(Shape::Empty));
    let mut p = Point { x: 1, y: 2 };
    p.x = p.x + 10;
    print(p.x * 100 + p.y);
}
